{
  "name": "giftshop-server",
  "version": "2.0.0",
  "description": "Gift shop e-commerce REST API (Node, Express, MongoDB)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
