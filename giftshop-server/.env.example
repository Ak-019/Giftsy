PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/giftshop
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Rate limits per IP per 15 minutes. Raise AUTH_RATE_LIMIT only on your own machine when running end-to-end tests.
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=1000
# Public URL of this API (used for uploaded image links). Optional locally.
SERVER_URL=http://localhost:5000

# Optional: Razorpay test mode. Leave empty to use the built-in mock payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: SMTP for order emails (e.g. a free Mailtrap or Brevo account). Leave empty to only log emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Giftsy <no-reply@giftsy.local>
